# top.lpf - iCESugar Pro (LFE5U-25F-6BG256C) pin constraints

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE      COMP "CLK"    SITE "P6";
IOBUF       PORT "CLK"    IO_TYPE=LVCMOS33;
FREQUENCY   PORT "CLK"    25 MHZ;

LOCATE COMP "LCD_CLK" SITE "J13";
IOBUF PORT "LCD_CLK" DRIVE=4 IO_TYPE=LVCMOS33;

LOCATE COMP "LCD_DEN" SITE "F13";
IOBUF PORT "LCD_DEN" DRIVE=4 IO_TYPE=LVCMOS33;

LOCATE COMP "LCD_R[0]" SITE "P11";
IOBUF PORT "LCD_R[0]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_R[1]" SITE "N12";
IOBUF PORT "LCD_R[1]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_R[2]" SITE "N13";
IOBUF PORT "LCD_R[2]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_R[3]" SITE "M12";
IOBUF PORT "LCD_R[3]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_R[4]" SITE "L14";
IOBUF PORT "LCD_R[4]" DRIVE=4 IO_TYPE=LVCMOS33;

LOCATE COMP "LCD_G[0]" SITE "P12";
IOBUF PORT "LCD_G[0]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_G[1]" SITE "P13";
IOBUF PORT "LCD_G[1]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_G[2]" SITE "P14";
IOBUF PORT "LCD_G[2]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_G[3]" SITE "M13";
IOBUF PORT "LCD_G[3]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_G[4]" SITE "L13";
IOBUF PORT "LCD_G[4]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_G[5]" SITE "K13";
IOBUF PORT "LCD_G[5]" DRIVE=4 IO_TYPE=LVCMOS33;

LOCATE COMP "LCD_B[0]" SITE "K14";
IOBUF PORT "LCD_B[0]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_B[1]" SITE "J14";
IOBUF PORT "LCD_B[1]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_B[2]" SITE "H14";
IOBUF PORT "LCD_B[2]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_B[3]" SITE "G14";
IOBUF PORT "LCD_B[3]" DRIVE=4 IO_TYPE=LVCMOS33;
LOCATE COMP "LCD_B[4]" SITE "F14";
IOBUF PORT "LCD_B[4]" DRIVE=4 IO_TYPE=LVCMOS33;


# SPI CS0: PlutoSky IQ data
# JP5 pin 7 (SCK) -> G2, JP5 pin 9 (MOSI) -> T3, JP5 pin 11 (MISO) -> T3, JP5 pin 13 (CS) -> R1
LOCATE COMP "spi_clk" SITE "G2";
IOBUF PORT "spi_clk" IO_TYPE=LVCMOS33;

LOCATE COMP "mosi" SITE "K1";
IOBUF PORT "mosi" IO_TYPE=LVCMOS33;

LOCATE COMP "cs" SITE "R3";
IOBUF PORT "cs" IO_TYPE=LVCMOS33;

# SPI CS1: Pico 2W command channel
# P5 header: D12=SCK, C11=MOSI, D13=CS
LOCATE COMP "spi_clk_pico" SITE "D12";
IOBUF PORT "spi_clk_pico" IO_TYPE=LVCMOS33;

LOCATE COMP "mosi_pico" SITE "C11";
IOBUF PORT "mosi_pico" IO_TYPE=LVCMOS33;

LOCATE COMP "cs1" SITE "D13";
IOBUF PORT "cs1" IO_TYPE=LVCMOS33;

# I2S DAC (PCM5102A direct-plug pinout)
LOCATE COMP "i2s_lrclk" SITE "R8";
IOBUF PORT "i2s_lrclk" DRIVE=4 SLEWRATE=SLOW IO_TYPE=LVCMOS33;

LOCATE COMP "i2s_sdata" SITE "C4";
IOBUF PORT "i2s_sdata" DRIVE=4 SLEWRATE=SLOW IO_TYPE=LVCMOS33;

LOCATE COMP "i2s_bclk"  SITE "C3";
IOBUF PORT "i2s_bclk"  DRIVE=4 SLEWRATE=SLOW IO_TYPE=LVCMOS33;

LOCATE COMP "i2s_sck"   SITE "E3";
IOBUF PORT "i2s_sck"   DRIVE=4 SLEWRATE=SLOW IO_TYPE=LVCMOS33;

# SDRAM IS42S16160B (32 MB x16)
# Pin assignments confirmed from icesugar-pro/src/litex_linux/top_bg256.lpf
LOCATE COMP "sdram_clk"    SITE "R15"; IOBUF PORT "sdram_clk"    DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_cke"    SITE "L16"; IOBUF PORT "sdram_cke"    DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_cs_n"   SITE "A14"; IOBUF PORT "sdram_cs_n"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_ras_n"  SITE "B16"; IOBUF PORT "sdram_ras_n"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_cas_n"  SITE "G16"; IOBUF PORT "sdram_cas_n"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_we_n"   SITE "A15"; IOBUF PORT "sdram_we_n"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_ba[0]"  SITE "G15"; IOBUF PORT "sdram_ba[0]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_ba[1]"  SITE "B14"; IOBUF PORT "sdram_ba[1]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dm[0]"  SITE "C16"; IOBUF PORT "sdram_dm[0]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dm[1]"  SITE "T15"; IOBUF PORT "sdram_dm[1]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_a[0]"   SITE "H15"; IOBUF PORT "sdram_a[0]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[1]"   SITE "B13"; IOBUF PORT "sdram_a[1]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[2]"   SITE "B12"; IOBUF PORT "sdram_a[2]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[3]"   SITE "J16"; IOBUF PORT "sdram_a[3]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[4]"   SITE "J15"; IOBUF PORT "sdram_a[4]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[5]"   SITE "R12"; IOBUF PORT "sdram_a[5]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[6]"   SITE "K16"; IOBUF PORT "sdram_a[6]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[7]"   SITE "R13"; IOBUF PORT "sdram_a[7]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[8]"   SITE "T13"; IOBUF PORT "sdram_a[8]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[9]"   SITE "K15"; IOBUF PORT "sdram_a[9]"   DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[10]"  SITE "A13"; IOBUF PORT "sdram_a[10]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[11]"  SITE "R14"; IOBUF PORT "sdram_a[11]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_a[12]"  SITE "T14"; IOBUF PORT "sdram_a[12]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;

LOCATE COMP "sdram_dq[0]"  SITE "F16"; IOBUF PORT "sdram_dq[0]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[1]"  SITE "E15"; IOBUF PORT "sdram_dq[1]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[2]"  SITE "F15"; IOBUF PORT "sdram_dq[2]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[3]"  SITE "D14"; IOBUF PORT "sdram_dq[3]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[4]"  SITE "E16"; IOBUF PORT "sdram_dq[4]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[5]"  SITE "C15"; IOBUF PORT "sdram_dq[5]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[6]"  SITE "D16"; IOBUF PORT "sdram_dq[6]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[7]"  SITE "B15"; IOBUF PORT "sdram_dq[7]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[8]"  SITE "R16"; IOBUF PORT "sdram_dq[8]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[9]"  SITE "P16"; IOBUF PORT "sdram_dq[9]"  DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[10]" SITE "P15"; IOBUF PORT "sdram_dq[10]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[11]" SITE "N16"; IOBUF PORT "sdram_dq[11]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[12]" SITE "N14"; IOBUF PORT "sdram_dq[12]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[13]" SITE "M16"; IOBUF PORT "sdram_dq[13]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[14]" SITE "M15"; IOBUF PORT "sdram_dq[14]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_dq[15]" SITE "L15"; IOBUF PORT "sdram_dq[15]" DRIVE=4 SLEWRATE=FAST IO_TYPE=LVCMOS33;

# PLL-derived clock frequency constraints
FREQUENCY NET "clk_pix"   30.0 MHz;
FREQUENCY NET "clk_sdram" 100.0 MHz;

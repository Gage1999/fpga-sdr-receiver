/* fishball7020 BOOT.BIN, AXI SPI on JP5
 * FSBL   : tezuka fishball7020 fsbl.elf
 * PL     : fishball7020_rf system_top.bit (maia-iio + axi_spi_jp5 @ 0x7C440000)
 * U-Boot : extracted from tezuka BOOT.bin (load/exec 0x04000000)
 */
the_ROM_image:
{
    [bootloader] fsbl.elf
    ../fishball7020_rf/fishball7020_rf.runs/impl_1/system_top.bit
    [load=0x04000000, startup=0x04000000] u-boot.bin
}
